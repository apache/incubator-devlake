      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "devlake-postgres-api"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS \"Merged, not yet deployed\"\nFROM project_pr_metrics\nWHERE (deployment_commit_id = '' OR deployment_commit_id IS NULL)\n  AND sub_project IS NOT NULL\n  AND ('${project:csv}' = '' OR project_name::text = ANY(ARRAY[${project:singlequote}]::text[]))\n  AND $__timeFilter(pr_merged_date)",
          "refId": "A"
        }
      ],
      "title": "Awaiting Deployment",
