    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "devlake-postgres-api"
      },
      "description": "Every attributed deployment, newest first, sourced from cicd_deployment_commits joined through the core cicd_deployment_subprojects mapping table.",
      "fieldConfig": {
