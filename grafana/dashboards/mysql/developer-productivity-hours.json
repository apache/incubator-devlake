            }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": [
            "sum"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "devlake-mysql-api"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT LPAD(CAST(hr AS CHAR), 2, '0') AS 'Hour', steering AS 'Steering', spec_mode AS 'Spec Mode', plain_chat AS 'Plain Chat' FROM (SELECT HOUR(timestamp) AS hr, SUM(CASE WHEN has_steering = 1 THEN 1 ELSE 0 END) AS steering, SUM(CASE WHEN is_spec_mode = 1 THEN 1 ELSE 0 END) AS spec_mode, SUM(CASE WHEN has_steering = 0 AND is_spec_mode = 0 THEN 1 ELSE 0 END) AS plain_chat FROM _tool_kiro_chat_log WHERE $__timeFilter(timestamp) GROUP BY HOUR(timestamp)) hourly ORDER BY hr",
          "refId": "A"
        }
      ],
      "title": "Feature Usage by Hour",
      "type": "barchart"
    },
