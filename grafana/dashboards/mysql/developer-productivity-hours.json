      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "devlake-mysql-api"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE weekday_num WHEN 1 THEN 'Sun' WHEN 2 THEN 'Mon' WHEN 3 THEN 'Tue' WHEN 4 THEN 'Wed' WHEN 5 THEN 'Thu' WHEN 6 THEN 'Fri' WHEN 7 THEN 'Sat' END AS 'Day', SUM(chat) AS 'Chat Events', SUM(comp) AS 'Completions' FROM (SELECT DAYOFWEEK(timestamp) AS weekday_num, COUNT(*) AS chat, 0 AS comp FROM _tool_kiro_chat_log WHERE $__timeFilter(timestamp) GROUP BY DAYOFWEEK(timestamp) UNION ALL SELECT DAYOFWEEK(timestamp) AS weekday_num, 0 AS chat, COUNT(*) AS comp FROM _tool_kiro_completion_log WHERE $__timeFilter(timestamp) GROUP BY DAYOFWEEK(timestamp)) activity GROUP BY weekday_num ORDER BY weekday_num",
          "refId": "A"
        }
      ],
      "title": "AI Activity by Day of Week",
      "type": "barchart"
