            "spanNulls": true,
            "stacking": {
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "devlake-mysql-api"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT LPAD(CAST(hr AS CHAR), 2, '0') AS 'Hour', ROUND(avg_prompt) AS 'Avg Prompt Length', ROUND(avg_response) AS 'Avg Response Length' FROM (SELECT HOUR(timestamp) AS hr, AVG(prompt_length) AS avg_prompt, AVG(response_length) AS avg_response FROM _tool_kiro_chat_log WHERE $__timeFilter(timestamp) GROUP BY HOUR(timestamp)) hourly ORDER BY hr",
          "refId": "A"
        }
      ],
      "title": "Prompt & Response Length by Hour",
      "type": "barchart"
    },
    {
      "datasource": {
        "type": "mysql",
