    {
      "datasource": "mysql",
      "description": "Compare billing cycle spend vs sum(chargedCents) since cycle start. Requires full event backfill for accurate reconciliation.",
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "Cycle Spend|Event Charged" },
            "properties": [
              { "id": "unit", "value": "currencyUSD" },
              { "id": "decimals", "value": 2 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Events Since Cycle Start" },
            "properties": [{ "id": "unit", "value": "short" }]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "id": 31,
      "options": {
        "cellHeight": "sm",
        "footer": { "show": false },
        "showHeader": true
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": "mysql",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT s.email AS \"User\",\n  s.spend_cents / 100 AS \"Cycle Spend\",\n  COALESCE(SUM(e.charged_cents), 0) / 100 AS \"Event Charged\",\n  COUNT(e.event_id) AS \"Events Since Cycle Start\"\nFROM _tool_cursor_user_spend s\nLEFT JOIN _tool_cursor_usage_events e\n  ON s.email = e.user_email\n AND e.event_time >= s.billing_cycle_start\n AND e.connection_id = s.connection_id\n AND e.scope_id = s.scope_id\nWHERE s.connection_id = ${connection_id}\n  AND s.scope_id = '${scope_id}'\nGROUP BY s.email, s.spend_cents\nHAVING COUNT(e.event_id) > 0 OR s.spend_cents > 0\nORDER BY s.spend_cents DESC\nLIMIT 50",
          "refId": "A"
        }
      ],
      "title": "Spend vs Events Reconciliation",
      "type": "table"
    },
