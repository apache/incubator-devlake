        {
          "datasource": "mysql",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(MAX(NULLIF(m.name, '')), e.user_email) AS \"User\",\n  CONCAT('$', FORMAT(SUM(e.charged_cents) / 100, 2)) AS \"Charged\"\nFROM _tool_cursor_usage_events e\nLEFT JOIN _tool_cursor_members m\n  ON e.user_email = m.email\n AND e.connection_id = m.connection_id\n AND e.scope_id = m.scope_id\n AND m.is_removed = 0\nWHERE $__timeFilter(e.event_time)\n  AND e.connection_id = ${connection_id}\n  AND e.scope_id = '${scope_id}'\nGROUP BY e.user_email\nORDER BY SUM(e.charged_cents) DESC\nLIMIT 25",
          "refId": "A"
        }
      ],
      "title": "Cost by User",
      "type": "table"
    },
